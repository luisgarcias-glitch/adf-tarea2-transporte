{
	"name": "df_bronze_viajes",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_viajes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "bronze_viajes_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_viajes_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fec_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_reportados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2023",
				"csv select(mapColumn(",
				"          id_viaje,",
				"          cod_ruta,",
				"          nro_bus,",
				"          fec_servicio,",
				"          hora_programada,",
				"          hora_salida,",
				"          hora_llegada,",
				"          pasajeros_reportados,",
				"          km_recorridos,",
				"          estado_viaje,",
				"          tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"xls2022 select(mapColumn(",
				"          id_viaje,",
				"          cod_ruta,",
				"          nro_bus,",
				"          fecha_servicio,",
				"          hora_programada,",
				"          hora_salida,",
				"          hora_llegada,",
				"          pasajeros_estimados,",
				"          km_recorridos,",
				"          estado_viaje,",
				"          tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xls2023 select(mapColumn(",
				"          id_viaje,",
				"          cod_ruta,",
				"          nro_bus,",
				"          fecha_servicio,",
				"          hora_programada,",
				"          hora_salida,",
				"          hora_llegada,",
				"          pasajeros_estimados,",
				"          km_recorridos,",
				"          estado_viaje,",
				"          tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3"
			]
		}
	}
}