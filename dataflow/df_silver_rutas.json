{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(CodigoRuta = toInteger(replace(replace(trim(CodigoRuta), 'Ruta ', ''), 'R-', '')),",
				"          VigenciaDesde = coalesce(toDate(VigenciaDesde, 'yyyy-MM-dd'), toDate(VigenciaDesde, 'dd/MM/yyyy')),",
				"          VigenciaHasta = coalesce(toDate(VigenciaHasta, 'yyyy-MM-dd'), toDate(VigenciaHasta, 'dd/MM/yyyy')),",
				"          NombreRuta = trim(NombreRuta),",
				"          Origen = trim(Origen),",
				"          Destino = trim(Destino),",
				"          Estado = upper(trim(Estado)),",
				"          RutaHistoricaId = trim(RutaHistoricaId)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}