{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = toInteger(replace(replace(ViajeId, 'Ruta ', ''), 'R-', '')),",
				"          VehiculoId = trim(replace(VehiculoId, 'V-', '')),",
				"          FechaServicio = toDate(FechaServicio, 'dd/MM/yyyy'),",
				"          KmRecorridos = toDouble(replace(KmRecorridos, ',', '.')),",
				"          HoraSalida = toTimestamp(concat(FechaServicio, ' ', HoraSalida), 'dd/MM/yyyy HH:mm'),",
				"          HoraLlegada = toTimestamp(concat(FechaServicio, ' ', HoraLlegada), 'dd/MM/yyyy HH:mm'),",
				"          HoraProgramada = toInteger((toTimestamp(concat(FechaServicio, ' ', HoraSalida), 'dd/MM/yyyy HH:mm') - toTimestamp(concat(FechaServicio, ' ', HoraProgramada), 'dd/MM/yyyy HH:mm')) / 60000)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> sink1"
			]
		}
	}
}